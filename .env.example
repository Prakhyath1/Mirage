# MIRAGE configuration — copy to .env and edit. Defaults (listed here) work
# out of the box; every value falls back safely when malformed.

# --- LLM provider (T2) -----------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# --- Agent bounds (T2) -----------------------------------------------------
AGENT_MAX_MEMORY=20
AGENT_MAX_CONTEXT=6000
AGENT_MAX_RESPONSE=2000
AGENT_MAX_COMMAND_LEN=2000
AGENT_ENABLE_GUARDRAIL=true
AGENT_REPAIR_ATTEMPTS=1
AGENT_MAX_LLM_CALLS_PER_DECISION=2

# --- Deception persona (T2/T3 host identity) -------------------------------
MIRAGE_PERSONA_HOSTNAME=web-prod-01
MIRAGE_PERSONA_ROLE=nginx web application server
MIRAGE_PERSONA_USERNAME=admin
MIRAGE_PERSONA_UID=1000
